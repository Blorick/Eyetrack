# ============================================================================
# PH1P35MDG324 pin plan -- two_board master board (top_ph1p_master)
# ----------------------------------------------------------------------------
# Board   : 康芯 HX1P35A / HX1P35B (device PH1P35MDG324)
# Sources : 9_康芯开发板使用手册及实验平台/新HX1P35A开发板手册-HDL版2604.pdf
#             p6  "②、50M时钟源"                 -> I_sys_clk
#             p8  "④、以太网接口"                -> RGMII shell (YT8511)
#             p13 "⑧、MIPI_CSI接口"              -> camera I2C / FCLK / FPWDNB
#             p14 "⑨、HDMI接口" + p15            -> TMDS data/clock pairs
#             p20 "⑭、4组LED发光管"              -> O_led[3:0]
#             p21 "⑯、乒乓开关"                  -> I_sw1 / I_sw2
#             p23 "⑱、4组按键"                   -> I_key1..I_key4
#           2_Example/33_ethernet_udp_led/uisrc/04_pin/fpga_pin.adc
#                                              -> I_a_rgmii_rxc = V3
#
# STATUS: read_adc is applied in the syn_1 run and the IO constraints are
# carried into phy_1 through PH1P_master_two_board_gate.db.  The 2026-10-11
# 15:35 physical run passed and produced PH1P_master_two_board.bit
# (Run phy_1 success / PRJ-1424 best result saved).  This file is unchanged in
# value; only provenance comments were added.
#
# The external I_rst_n and O_screen_pwm ports are removed in this master top:
# R10/R11 are confirmed Ethernet TX_CTL/TXD0 balls.  A deterministic 50 MHz
# FPGA POR drives internal reset, while camera reset remains the real L2 pad.
#
# RGMII is 1 Gb/s only.
# ============================================================================

# --- manual p6: "时钟信号 CLK  FPGA 引脚 C4" (50 MHz oscillator, 3.3 V bank) ---
set_pin_assignment { I_sys_clk } { LOCATION = C4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# --- manual p13: MIPI_CSI_I2C_FSCL K3 / MIPI_CSI_I2C_FSDA J3
#                 MIPI_CSI_FCLK     L3 / MIPI_CSI_FPWDNB   L2 ---
set_pin_assignment { O_cam_scl }  { LOCATION = K3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { IO_cam_sda } { LOCATION = J3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { O_cam_24m }  { LOCATION = L3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { O_cam_rst }  { LOCATION = L2; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# --- manual p23: KEY1 D5 / KEY2 A9 / KEY3 B9 / KEY4 C7, pressed = low ---
set_pin_assignment { I_key1 } { LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_key2 } { LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_key3 } { LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_key4 } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# --- manual p21: SW1 A4 / SW2 B4 ---
set_pin_assignment { I_sw1 }  { LOCATION = A4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_sw2 }  { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# --- manual p14/p15: HDMI1_D0_P G16 / D1_P F17 / D2_P H14 / CLK_P C17.
#     The N-side pads (H16 / E18 / H13 / D18) are generated by the TMDS33
#     differential standard and are not assigned here. ---
set_pin_assignment { O_tmds_ch0_p } { LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { O_tmds_ch1_p } { LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { O_tmds_ch2_p } { LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment { O_tmds_clk_p } { LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }

# --- manual p20: LED1 D10 / LED2 E10 / LED3 C6 / LED4 D6, active high ---
set_pin_assignment { O_led[0] }      { LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_led[1] }      { LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_led[2] }      { LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_led[3] }      { LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# --- manual p8 Ethernet table:
#     TXCLK U9 | TXD0 R11 | TXD1 P11 | TXD2 T10 | TXD3 R12 | TXEN R10
#     RXD0  N9 | RXD1 T7  | RXD2 T8  | RXD3 T9  | RXC_DV N8
#     MDC0  V9 | MDIO0 U10 | RESET_N V8
#   The manual's Ethernet table does not list the recovered RX clock.  V3 comes
#   from the vendor example for this board:
#   E:\...\2_Example\33_ethernet_udp_led\uisrc\04_pin\fpga_pin.adc
#       set_pin_assignment { I_a_rgmii_rxc } { LOCATION = V3; ... }
#   V3 is schematic ball IO_BE17P_22,GCLKIOT1 (HX1P35B_FT_40P_2.pdf), i.e. a
#   GCLK-capable pad, which is what an RGMII RXC needs.
set_pin_assignment { O_eth_txc }     { LOCATION = U9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_eth_txd[0] }  { LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_eth_txd[1] }  { LOCATION = P11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_eth_txd[2] }  { LOCATION = T10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_eth_txd[3] }  { LOCATION = R12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { O_eth_tx_ctl }  { LOCATION = R10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rxc }     { LOCATION = V3;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rxd[0] }  { LOCATION = N9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rxd[1] }  { LOCATION = T7;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rxd[2] }  { LOCATION = T8;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rxd[3] }  { LOCATION = T9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_eth_rx_ctl }  { LOCATION = N8;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { O_eth_mdc }     { LOCATION = V9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { IO_eth_mdio }   { LOCATION = U10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { O_eth_rst_n }   { LOCATION = V8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# DDR2/MIPI pads are owned by their generated PH1P IP and ddr2.adc closure;
# they are deliberately not duplicated here.
# --- v1.19 vehicle-service extension: SW3/SW4, gimbal servo and TF/SD SPI ---
# SW3 enables automatic tracking; SW4 selects manual gimbal jogging.
set_pin_assignment { I_sw3 }       { LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_sw4 }       { LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
# Bus-servo single-wire output (MCU UART1 TX) to the gimbal connector; C18.
set_pin_assignment { O_servo_bus }  { LOCATION = C18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
# Preserve the reported existing J1-2 / D15 connection, with the reference's
# 16 mA drive. The actual working reference PR DB drives E12 (manual J1-3),
# so mirror the SAME waveform there as well; do not require a cable move.
# J1-1 / C18 remains the bus servo. Both DIN pads are 3.3 V, not LED power.
set_pin_assignment { O_fill_din }     { LOCATION = D15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_fill_din_ref } { LOCATION = E12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = PULLDOWN; }
# SPI-mode TF/SD card: clock, chip-select, command/MOSI, data0/MISO.
set_pin_assignment { O_tf_clk }     { LOCATION = A7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_tf_cs_n }    { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { O_tf_mosi }    { LOCATION = A8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment { I_tf_miso }    { LOCATION = E8;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# --- manual pin-assignment summary table VII / p20: 8-digit 7-segment display ---
#   2 groups x 4 digits, 8 digits total.  Segment lines DIG[0..7] = a,b,c,d,e,f,g,DP
#   are bussed; digit selects SEL[0..7] = leftmost..rightmost.  These 16 pads are
#   multiplexed with the 8 dual-colour LED groups, so on-board SW6 must be switched
#   on for the 7-segment display.  Polarity is fixed at 2'b10 in the top
#   (segment low-active + digit-select one-low active), measured on the same
#   board in v1.13; the pin table itself is board-defined, not timing-defined,
#   so the v1.13 constraint values are kept verbatim.
set_pin_assignment { O_seg_dig[0] } { LOCATION = C9;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[1] } { LOCATION = C11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[2] } { LOCATION = B11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[3] } { LOCATION = E7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[4] } { LOCATION = E6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[5] } { LOCATION = B6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[6] } { LOCATION = B7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_dig[7] } { LOCATION = E5;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[0] } { LOCATION = G15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[1] } { LOCATION = G14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[2] } { LOCATION = A17; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[3] } { LOCATION = A18; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[4] } { LOCATION = B16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[5] } { LOCATION = A15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[6] } { LOCATION = B15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment { O_seg_sel[7] } { LOCATION = A14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
